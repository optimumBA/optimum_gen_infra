app = "<%= fly_app_prefix %>-staging"
kill_signal = "SIGTERM"
primary_region = "fra"

[build]

[deploy]
<%= if ecto do %>release_command = "/app/bin/migrate"
<% end %>strategy = "immediate"

[env]
PHX_HOST = "<%= fly_app_prefix %>-staging.fly.dev"
PORT = "8080"
PRIMARY_REGION = "fra"

[http_service]
auto_start_machines = true
auto_stop_machines = true
force_https = true
internal_port = 8080
min_machines_running = 0
processes = ["app"]

[http_service.concurrency]
hard_limit = 1000
soft_limit = 1000
type = "connections"

[[http_service.checks]]
grace_period = "15s"
interval = "10s"
method = "GET"
path = "/health"
timeout = "2s"

[[vm]]
cpu_kind = "shared"
cpus = 1
memory_mb = 512
